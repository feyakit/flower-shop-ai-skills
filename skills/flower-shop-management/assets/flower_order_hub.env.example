# Flower Order Hub config

# Local SQLite database file.
FLOWER_ORDER_DB=flower_orders.db

# Optional AI parser.
# If these are empty, the script will use the built-in rule parser.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Maiyatian outbound dispatch connector.
# Ask Maiyatian support/open platform for the official order-create endpoint,
# token, signature algorithm, and required field list.
MAIYATIAN_API_URL=
MAIYATIAN_TOKEN=
MAIYATIAN_SECRET=
MAIYATIAN_AUTH_HEADER=Authorization
MAIYATIAN_AUTH_SCHEME=Bearer
MAIYATIAN_SIGN_HEADER=X-Signature
